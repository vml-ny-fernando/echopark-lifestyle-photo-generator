{
  "name": "echopark-scene-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:api": "PORT=3001 tsx watch src/index.ts",
    "dev:web": "vite",
    "start": "node --enable-source-maps .build/index.mjs",
    "build": "tsc --noEmit && vite build && node -e \"require('esbuild').build({entryPoints:['src/index.ts'],bundle:true,platform:'node',packages:'external',keepNames:true,ignoreAnnotations:true,target:'node'+process.versions.node,format:'esm',sourcemap:true,logLevel:'warning',outfile:'.build/index.mjs'}).catch(()=>process.exit(1))\"",
    "typecheck": "tsc --noEmit",
    "seed:vehicles": "tsx scripts/seed-vehicles.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1018.0",
    "@aws-sdk/s3-request-presigner": "3.1018.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/parkinsans": "^5.3.0",
    "@koa/router": "^15.5.0",
    "@tanstack/react-query": "^5.100.10",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "koa": "^3.2.0",
    "koa-static": "^5.0.0",
    "lucide-react": "1.28.0",
    "react": "^19.2.6",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/koa": "^3.0.2",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4",
    "esbuild": "0.28.2",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vite": "^6"
  }
}
