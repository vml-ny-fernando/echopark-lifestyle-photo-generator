# Copy to .env for local runs (never commit .env). On Heroku set these as Config Vars.
APP_PASSWORD=change-me            # shared tester password; unset = no sign-in (local only)
SESSION_SECRET=long-random-string # signs session cookies and upload URLs
GEMINI_API_KEY=                   # Google AI Studio key: https://aistudio.google.com/apikey
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Storage: Bucketeer sets BUCKETEER_* automatically. For any other S3 bucket:
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT=          # S3-compatible services, e.g. Supabase: https://<ref>.storage.supabase.co/storage/v1/s3
# S3_PREFIX=echopark-scene-studio/
# Without a bucket, files go to LOCAL_STORAGE_DIR (default .data/) — local dev only.
